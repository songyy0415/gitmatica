{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"name": "${mod_name}",
	"version": "${mod_version}",

	"description": "A Litematica fork with Git-backed structure version control for tracking, committing, branching, and restoring builds.",
	"authors": [
		"${author}"
	],
	"contributors": [
		"masa",
		"Sakura-Ryoko"
	],
	"contact": {
		"homepage": "https://github.com/Arnavpmr/gitmatica",
		"issues": "https://github.com/Arnavpmr/gitmatica/issues",
		"sources": "https://github.com/Arnavpmr/gitmatica"
	},

	"license": "LGPL-3.0-only",
	"icon": "assets/litematica/gitmatica_icon.png",

	"environment": "client",
	"entrypoints": {
		"main": [
			"fi.dy.masa.litematica.Litematica"
		],
		"modmenu": [
			"fi.dy.masa.litematica.compat.modmenu.ModMenuImpl"
		]
	},
	"mixins": [
		"mixins.litematica.json"
	],
    "accessWidener": "litematica.accesswidener",

	"depends": {
		"minecraft": "~${minecraft_version}-",
		"malilib": ">=${malilib_version}- <0.30.0-"
	},
	"breaks": {
		"malilib": "<${malilib_version}-"
	}
}
